# ==========================================
# Axinix E-Commerce Platform - Backend Environment
# ==========================================

# 1. Local MySQL Database (Active when DEBUG=True)
MYSQL_HOST=localhost
MYSQL_PORT=port
MYSQL_USER=username
MYSQL_PASSWORD=password
MYSQL_DATABASE=database_name

# 2. Live Cloud MySQL Database (Active automatically when DEBUG=False)
# Format: mysql://<username>:<password>@<host>:<port>/<database>?ssl-mode=REQUIRED
MYSQL_DATABASE_LIVE=website_url

# 3. Django Core Configuration
DEBUG=True
SECRET_KEY=django-insecure-change-this-to-a-secure-random-secret-key
ALLOWED_HOSTS=*
